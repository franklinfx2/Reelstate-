# Supabase project (Settings -> API in the Supabase dashboard).
# Apply supabase/migrations/20260914000000_orders_schema.sql to this
# project before running the app.
NEXT_PUBLIC_SUPABASE_URL=

# Service-role key — used server-side only, for the /order and /admin
# flows (orders/order_photos have no anon-key RLS policies at all).
# Settings -> API -> service_role in the Supabase dashboard. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ORDER_PHOTOS_BUCKET=order-photos
SUPABASE_ORDER_VIDEOS_BUCKET=order-videos

# Admin dashboard (/admin) — pick your own password and a long random
# string for the session secret (e.g. `openssl rand -hex 32`).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Shown on the order tracking page as Mobile Money payment instructions.
PAYMENT_MOMO_NUMBER=
PAYMENT_MOMO_NAME=
