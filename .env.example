# Supabase project (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=property-media

# Optional — without this, marketing copy falls back to a template generator
ANTHROPIC_API_KEY=

# "Photos only" Kling video flow (src/app/reel/*) — talks to the Edge
# Functions backend documented in supabase/README's "Edge function backend"
# section, i.e. a DIFFERENT Supabase project than NEXT_PUBLIC_SUPABASE_URL
# above. See supabase/reel_schema.sql for the schema this flow needs.
NEXT_PUBLIC_REEL_SUPABASE_URL=
NEXT_PUBLIC_REEL_SUPABASE_ANON_KEY=
