SUPABASE_URL=
SUPABASE_ANON_KEY=

# Set on the deployed project (not here) via `supabase secrets set ...`:
#   ANTHROPIC_API_KEY   — reel-generate's photo analysis/selection/prompts
#   GH_PAT, GH_OWNER, GH_REPO, GH_REPO_REF — dispatches reel-process-video.yml
#     (same secrets already used by functions/generate)
#   KLING_API_KEY (or KLING_ACCESS_KEY + KLING_SECRET_KEY) — Kling Open
#     Platform credentials, used by reel-generate/reel-poll-clips via
#     functions/_shared/kling.ts. Kept Supabase-only, never passed to GitHub
#     Actions. Optional KLING_API_BASE if not on the default
#     https://api-singapore.klingai.com endpoint. Optional KLING_MODEL_NAME
#     (defaults to "kling-v1", likely stale — confirm against your account;
#     see README).
#
# reel-poll-clips also needs a Supabase Cron Job (or pg_cron, see README)
# calling it every ~1 minute — it's not invoked by the frontend.
#
# GitHub Actions repo secrets (Settings -> Secrets and variables -> Actions),
# used by .github/workflows/reel-process-video.yml — assembly only, no Kling
# credentials needed there:
#   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY
#
# Local `supabase functions serve` picks up SUPABASE_URL, SUPABASE_ANON_KEY,
# and SUPABASE_SERVICE_ROLE_KEY automatically from the linked project — you
# don't need to set those here.
