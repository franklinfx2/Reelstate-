SUPABASE_URL=
SUPABASE_ANON_KEY=

# Set on the deployed project (not here) via `supabase secrets set ...`:
#   ANTHROPIC_API_KEY   — reel-generate's photo analysis/selection/prompts
#   GH_PAT, GH_OWNER, GH_REPO, GH_REPO_REF — dispatches reel-process-video.yml
#     (same secrets already used by functions/generate)
# And as GitHub Actions repo secrets (Settings -> Secrets and variables ->
# Actions), used by .github/workflows/reel-process-video.yml:
#   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY
#   KLING_ACCESS_KEY, KLING_SECRET_KEY — Kling Open Platform credentials
#   KLING_API_BASE (optional repo variable, not secret) — defaults to
#     https://api-singapore.klingai.com
#
# Local `supabase functions serve` picks up SUPABASE_URL, SUPABASE_ANON_KEY,
# and SUPABASE_SERVICE_ROLE_KEY automatically from the linked project — you
# don't need to set those here.
